# ════════════════════════════════════════════
# Omni‑Stack: Minimal .env Template
# ════════════════════════════════════════════
#
# Only POSTGRES_PASSWORD and COMPOSE_PROFILES are
# mandatory.  Everything else is optional (leave
# commented out to use the docker-compose default).


# ── Always required ─────────────────────────

COMPOSE_PROFILES=                # e.g. "memory,tunnel" or "mattermost,memory"
POSTGRES_PASSWORD=               # single truly-required secret


# ── S3 (backup / restore / checkpoint) ──────
# Only needed if you enable backup or checkpoint
# cron schedules in docker-compose.yml.

# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_PATH=                        # object prefix within the bucket (default: omni)
# BACKUP_CRON_SCHEDULE=            # periodic backup to S3 (crontab), e.g. "0 3 * * *"
# CHECKOUT_CRON_SCHEDULE=         # periodic checkpoint to S3 (crontab), each run→separate YYYYMMDD prefix


# ── Cloudflare Tunnel ───────────────────────
# Only needed with profile "tunnel" or "all".

# TUNNEL_TOKEN=


# ── Mattermost ──────────────────────────────
# Only needed with profile "mattermost" or "all".
# MM_SITEURL is optional; Mattermost auto-
# detects from the first HTTP request if empty.

# MM_POSTGRES_PASSWORD=
# MM_SITEURL=


# ── Paperclip ───────────────────────────────
# Only needed with profile "paperclip" or "all".
# BETTER_AUTH_SECRET is REQUIRED (vendor-enforced;
# docker compose refuses to start without it).
# Generate: openssl rand -hex 32

# BETTER_AUTH_SECRET=
# PAPERCLIP_PUBLIC_URL=           # default: http://paperclip:3100
# PAPERCLIP_DEPLOYMENT_MODE=      # default: authenticated (alternatives: local_trusted)
# PAPERCLIP_DEPLOYMENT_EXPOSURE=  # default: private (alternatives: public)
# PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=  # optional; generate: openssl rand -hex 32
# PAPERCLIP_IMAGE=                # default: ghcr.io/paperclipai/paperclip:sha-e55d702


# ── workbench service (profile "workbench") ─
# Opt-in: enabled via COMPOSE_PROFILES=workbench
# (or "all"); it is NOT in the default stack.
# Workbench plugins host (node image built from
# services/workbench/Dockerfile by the dev overlay,
# which clones the nexuslbs/workbench CORE at build
# time). The core image ships NO plugin-repository
# dependency: the plugins config decides what is
# loaded. /opt is mapped in-and-out (same path in
# and out), so a WORKBENCH_CONFIG_FILE under /opt/... is the
# same file inside and outside the container.

# WORKBENCH_CONFIG_FILE=         # empty default = core default config (image); e.g. /opt/omni/config/workbench.yml
# WORKBENCH_REPO_URL=            # default: https://github.com/nexuslbs/workbench
# WORKBENCH_REF=                 # default: main (branch or tag of WORKBENCH_REPO_URL)
# WORKBENCH_IMAGE=               # default: ghcr.io/nexuslbs/workbench:latest (published core image)
# WORKBENCH_PORT=                # default: 8080 (status endpoint INSIDE the container; the dev overlay publishes host 12347:8080)
# WORKBENCH_CACHE_DIR=           # path INSIDE the external named volume workbench-cache (default: /var/lib/workbench/sources)
#
# The service also mounts the host docker daemon
# socket (/var/run/docker.sock) and the image
# carries the docker CLI + compose v2 plugin + an
# ssh client: the plugins' `container` / `ssh`
# transports reach external tooling BEHIND THE
# SCENES (the omni workstation-tools image, which runs himalaya)
# via `docker compose exec`. No env var is needed
# for that: the default socket path is used and
# the transport passes -p / -f / --env-file
# explicitly.


# ── workstation service (profile "workstation") ─
# Opt-in: enabled via COMPOSE_PROFILES=workstation
# (or "all"); it is NOT in the default stack.
# Workstation plugins host (node image built from
# services/workstation/Dockerfile by the dev overlay,
# which clones the nexuslbs/deepseek-harness CORE at
# build time). Same contract as workbench: the core
# image ships NO plugin-repository dependency - the
# cordis plugins config decides what is loaded; /opt
# is mapped in-and-out (same path in and out), so a
# WORKSTATION_CONFIG_FILE under /opt/... is the same
# file inside and outside the container. THIS stack
# tracks its production config in the repo:
# config/workstation.yml.

# WORKSTATION_CONFIG_FILE=     # empty default = core default config (image); e.g. /opt/omni/config/workstation.yml
# WORKSTATION_REPO_URL=        # default: https://github.com/nexuslbs/deepseek-harness
# WORKSTATION_REF=             # default: master (branch or tag of WORKSTATION_REPO_URL)
# WORKSTATION_IMAGE=           # default: ghcr.io/nexuslbs/deepseek-harness:latest (published core image)
# WORKSTATION_PORT=            # default: 8080 (status endpoint INSIDE the container; the dev overlay publishes host 12348:8080)
# WORKSTATION_CACHE_DIR=       # path INSIDE the external named volume workstation-cache (default: /var/lib/workstation/sources)
#
# The service also mounts the host docker daemon
# socket (/var/run/docker.sock) and the image
# carries the docker CLI + compose v2 plugin + an
# ssh client: the plugins' `container` / `ssh`
# transports reach external tooling BEHIND THE
# SCENES (the omni workstation-tools image, which runs himalaya)
# via `docker compose exec`. No env var is needed
# for that: the default socket path is used and
# the transport passes -p / -f / --env-file
# explicitly.


# ── Optionals (sensible defaults) ───────────
# All image vars below have defaults in docker-
# compose.yml.  Override only to pin a version.

# EXPLORER_DIR=                   # dashboard file-explorer root (default: /opt)
# OMNI_DIR=                       # omniagent shared data root (default: /opt/omni)

# POSTGRES_IMAGE=                 # default: pgvector/pgvector:pg16
# OMNIAGENT_IMAGE=                # default: ghcr.io/nexuslbs/omni-deployer/omniagent:latest (public CI image)
# DASHBOARD_IMAGE=                # default: ghcr.io/nexuslbs/omni-deployer/dashboard:latest (public CI image)
# TOOLBOX_IMAGE=                  # default: ghcr.io/nexuslbs/omni-deployer/toolbox:latest (public CI image)
# BROWSER_IMAGE=                   # default: ghcr.io/nexuslbs/omni-images/browser:0.0.4 (browser service image, published from nexuslbs/omni-images)
# WORKSTATION_TOOLS_IMAGE=         # default: ghcr.io/nexuslbs/omni-images/workstation-tools:0.0.1 (himalaya + general tool set the workstation execs into)
# CLOUDFLARED_IMAGE=              # default: cloudflare/cloudflared:2026.7.1
# MATTERMOST_DB_IMAGE=            # default: postgres:16.14
# MATTERMOST_IMAGE=               # default: mattermost/mattermost-team-edition:10.11.20
# QDRANT_IMAGE=                   # default: qdrant/qdrant:v1.18.2
# HINDSIGHT_IMAGE=                # default: ghcr.io/vectorize-io/hindsight:0.7.2
# CADVISOR_IMAGE=                 # default: ghcr.io/google/cadvisor:v0.57.0
# PROMETHEUS_IMAGE=               # default: prom/prometheus:v3.5.5
# VECTOR_IMAGE=                   # default: timberio/vector:0.55.0-debian
# LOKI_IMAGE=                     # default: grafana/loki:3.7.2
# GRAFANA_IMAGE=                  # default: grafana/grafana:13.0.1

# --- external-plan X7: new credential classes (never commit) ---------------
# Values for these credential classes live ONLY in the secrets store or in an
# untracked .env file. Committing them is blocked by scripts/secret-scan.py and
# .gitleaks.toml (see the session-state / credentials guidance in .gitignore).
#   EMAIL_APP_PASSWORD=<app password>     himalaya password / password.command value
#   MODEM_SIM_PIN=<SIM PIN>               SMS modem / SIM PIN
#   TWILIO_ACCOUNT_SID=<account SID>      Twilio account SID (AC...)
#   TWILIO_API_KEY=<API key SID>          Twilio API key SID (SK...)
#   TWILIO_AUTH_TOKEN=<auth token>        Twilio auth token
#   TOTP_SECRET=<base32 secret>           TOTP/HOTP shared secret
#   PLAYWRIGHT_STORAGE_STATE=<file path>  per-site session file - never committed
# X7 owner task: task_omnidev_external_plan_x7_secrets_review_for
