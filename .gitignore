# omni-stack .gitignore
# Allow everything by default; only exclude build artifacts, env files, and secrets.

# ── Build artifacts ──
target/
node_modules/
dist/

# ── Environment / secrets ──
.env
.env.*.local
.env.bak
.env.cron
.env.omnidev
omnidev.env
omnideploy.env
*.pem
*.key

# ── Temporary / generated files ──
COMMIT_MSG.txt

# ── Git plugin cache (shared bare mirrors for remote plugin clones) ──
.git-cache/
*.bak
scripts/__pycache__/
docs/

# ── OS files ──
.DS_Store
Thumbs.db

# ── Runtime-only: temp, logs ──
*.log
tmp/

# Eliminated struct: workspace root, each plugin has own Cargo.toml
/Cargo.toml

# ── Runtime config artifacts created at repo root by deploy/test tooling ──
/actions.yml
/plugins.yml
/remote.yml
/settings.yml
/workflows.yml

# ── config/, profiles/ and plugins/ are NOT gitignored ──────────────────
# config/ (OMNI_DIR YAML), profiles/ (profile content) and plugins/
# (bundled plugins) are first-class content, never ignored. The seed
# (omni-stack) simply does not ship them: they may exist transiently during
# a deploy (created from omni-deployer/seed/config, the core's startup
# auto-created profiles/<default>/config.json, and the plugin API
# install-git) and are removed afterwards WITHOUT being committed. Forked
# repos commit their own config/, profiles/ and plugins/ (tracked files
# beat gitignore, so a fork that wants to track them just adds them).
# hindsight_watermark.json is live agent memory state and stays runtime-only.
/hindsight_watermark.json

# ── taskj patch artifacts (kanban task tool) ──
.taskj-*.patch

/data/
# ── Auto-generated remote plugin clones (ignored per type dir) ──
# ONLY these are gitignored: tests install remote plugins via install-git
# into plugins/<type>/.remote/; they are clones, never seed content. All
# OTHER plugin content under plugins/ is deliberately NOT gitignored, so a
# fork adding its own plugins never gets them silently excluded; test
# artifacts (test-* tools) are removed after the test run instead of being
# ignored.
plugins/platforms/.remote/
plugins/tools/.remote/
plugins/providers/.remote/

# ── Python bytecode cache ──
__pycache__/
*.pyc

# runtime copy of config.example.yml (operator/Vagrantfile created)
config.yml

# ─────────────────────────────────────────────
# Never-commit secret guardrails (code-plan C9)
# ─────────────────────────────────────────────
# Real env files and secret material must never be committed. Commit only
# the *.env.example / *.sample / *.dist placeholder templates (see
# scripts/secret-scan.py; pre-commit hook + CI job enforce this).
.env
.env.*
!.env.example
!.env.sample
!.env.dist
*.env
!*.env.example
!*.env.sample
!*.env.dist
config.yml
config.local.yml
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
*.secret
*.credential
secrets.env
secrets.env.*
id_rsa
id_ecdsa
id_ed25519

# ─────────────────────────────────────────────
# Never-commit secret guardrails, part 2 (external-plan X7): Playwright
# per-site session state and secrets files. A storage-state file carries LIVE
# cookies + localStorage for a logged-in site; a --secrets file carries the
# typed credential values. Neither may be committed - share a session through
# the secrets store instead (see the web-interaction skill).
# ─────────────────────────────────────────────
**/*storage-state*.json
**/*storage_state*.json
**/*storageState*.json
**/*.auth.json
**/sessions.json
**/playwright-secrets.*
**/pw-secrets.*
