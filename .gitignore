# omni-stack .gitignore
# Allow everything by default — only exclude build artifacts, env files, and secrets.

# ── Build artifacts ──
target/
node_modules/
dist/

# ── Environment / secrets ──
.env
.env.*.local
.env.bak
.env.cron
.env.omnidev
omnidev.env
omnideploy.env

# ── Temporary / generated files ──
COMMIT_MSG.txt

# ── Git plugin cache (shared bare mirrors for remote plugin clones) ──
.git-cache/
*.bak
scripts/__pycache__/
docs/

# ── OS files ──
.DS_Store
Thumbs.db

# ── Runtime-only: temp, logs ──
*.log
tmp/
profiles/default/tmp/
profiles/default/wiki/

# ── Eliminated struct — workspace root, each plugin has own Cargo.toml ──
/Cargo.toml

/data/
# ── Auto-generated remote plugin clones (ignored per type dir) ──
# ONLY these are gitignored: tests install remote plugins via install-git
# into plugins/<type>/.remote/ — they are clones, never seed content. All
# OTHER plugin content under plugins/ is deliberately NOT gitignored, so a
# fork adding its own plugins never gets them silently excluded; test
# artifacts (test-* tools) are removed after the test run instead of being
# ignored.
plugins/platforms/.remote/
plugins/tools/.remote/
plugins/providers/.remote/

# ── Python bytecode cache ──
__pycache__/
*.pyc
